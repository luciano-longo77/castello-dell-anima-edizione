<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://www.tei-c.org/release/xml/tei/custom/schema/relaxng/tei_all.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<?xml-model href="http://www.tei-c.org/release/xml/tei/custom/schema/relaxng/tei_all.rng" type="application/xml"
	schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0">
  <teiHeader>
    <!-- Il teiHeader completo e' modellato a parte: cfr. teiHeader-model.xml; 
      questa a seguire è solo una struttura basica di TEI-ALL P5 -->
    <fileDesc>
      <titleStmt>
        <title>Title</title>
      </titleStmt>
      <publicationStmt>
        <p>Publication Information</p>
      </publicationStmt>
      <sourceDesc>
        <p>Information about the source</p>
      </sourceDesc>
    </fileDesc>
  </teiHeader>
  <text>
    <front> 
      <div type="witness-list">
        <listWit>
          <witness xml:id="txt-b0" resp="#s-teresa"/>
          <witness xml:id="txt-b1" resp="#s-teresa"/>
          <witness xml:id="txt-1" resp="#s-teresa"/>
          <witness xml:id="txt-2" resp="#s-teresa"/>
          <witness xml:id="txt-3" resp="#s-teresa"/>
          <witness xml:id="txt-4" resp="#esterno"/>
          <witness xml:id="txt-c" resp="#editor"/>
        </listWit>
      </div>
      <div type="person-list">
        <listPerson>
          <person xml:id="s-teresa"/>
          <!-- ripeti per ciascuna persona (autrice, fonti, direttore, curatore) -->
        </listPerson>
      </div>
      <div type="source-list">
        <!-- Fonti dell'intertesto (layer 3)-->
        <listBibl type="fontes">
          <bibl xml:id="bible-vulgate"><title level="m"/></bibl>
          <bibl xml:id="molinos-guida"><author/><title/><date/></bibl>
          <bibl xml:id="avila-castello"><author/><title/><date/></bibl>
        </listBibl>
      </div>
      <titlePage>
        <docTitle>
          <titlePart type="main"/>
          <titlePart type="sub"/>
        </docTitle>
        <docAuthor/>
      </titlePage>
    </front>

    <body>
      <!-- LIBRO I -->
      <div type="book" n="1" xml:id="libro-1">
        <pb n="1r" facs="/" xml:id="pb-1r"/>
        <head/>
        <!-- capitoli con la stessa struttura del Libro III (vedi sotto) -->
      </div>

      <!-- LIBRO II -->
      <div type="book" n="2" xml:id="libro-2">
        <pb n="63r" facs="/" xml:id="pb-63r"/>
        <head/>
        <!-- capitoli con la stessa struttura del Libro III (vedi sotto) -->
      </div>

      <!-- LIBRO III (focus dell'edizione) -->
      <div type="book" n="3" xml:id="libro-3">
        <fw type="sig" place="bottom" xml:id="fw-158r"/>
        <pb n="158r" facs="/" xml:id="pb-158r"/>
        <head/>

        <!-- PREFAZIONE -->
        <div type="preface">
          <head/>
          <argument>
            <p n="1"/>
          </argument>
        </div>

        <!-- CAPITOLO: unita' di riferimento = <p n="…">-->
        <div type="chapter" n="1" xml:id="III-cap1">
          <head/>
          <argument>
            <!-- Layer 2 (mistico-dottrinale): term/@ref al vocabolario controllato degli stati -->
            <p>Si tratta della dispositione che lascia nell'anima la
              <term ref="#notte">notte dello spirito</term>.</p>
          </argument>

          <p n="1" xml:id="III-cap1-p1">
            <!-- Layer 1 (filologico-grafico): trascrizione a due livelli via choice -->
            <choice><orig/><reg/></choice>
            <choice><abbr/><expan/></choice>
            <choice><sic/><corr/></choice>

            <!-- Layer 1: fenomeni materiali e correzioni autoriali -->
            <add place="margin" hand="#ink_2" resp="#s-teresa" type="integration"/>
            <del hand="#ink_1"/>
            <subst><del hand="#ink_1"/><add hand="#ink_2"/></subst>
            <unclear reason="illegible"/>
            <gap reason="illegible" unit="word" quantity="1"/>
            <supplied reason="damage"/>

            <!-- Layer 1: apparato genetico in parallel segmentation -->
            <app>
              <lem wit="#txt-c"/>
              <rdg wit="#txt-b0" varSeq="1"/>
              <rdg wit="#txt-1" varSeq="2"/>
              <rdg wit="#txt-2" varSeq="3"/>
              <rdg wit="#txt-3" varSeq="4"/>
            </app>

            <!-- Layer 2: lessico mistico -->
            <term ref="#unione"/>

            <!-- Layer 3 (intertestuale): rimandi e citazioni con fonte -->
            <ref target="#avila-castello" type="model"/>
            <cit type="bible">
              <quote xml:lang="la"><foreign xml:lang="la"/></quote>
              <bibl corresp="#bible-vulgate"/>
            </cit>
          </p>
          <!-- ripeti <p n="…"> per ciascun paragrafo del capitolo -->
        </div>
        <!-- ripeti <div type="chapter" n="…"> per ciascun capitolo -->
      </div>
    </body>
  </text>
</TEI>
