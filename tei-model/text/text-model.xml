<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:lang="it">
  <teiHeader>
    <!-- teiHeader modellato in ../header/teiHeader-model.xml. -->
    <fileDesc>
      <titleStmt>
        <title/>
      </titleStmt>
      <publicationStmt>
        <p/>
      </publicationStmt>
      <sourceDesc>
        <p/>
      </sourceDesc>
    </fileDesc>
  </teiHeader>

  <text xml:lang="it">
    <front>
      <!-- listWit / listPerson / listBibl NON stanno nel front:
           sono dichiarati una sola volta nel teiHeader; nel testo si puntano via @wit/@ref/@target -->
      <titlePage>
        <docTitle>
          <titlePart/>
          <titlePart/>
        </docTitle>
        <docAuthor/>
      </titlePage>
    </front>

    <body>
      <!-- Libri I e II: stessa struttura; fuori dal focus dei micro-commit (che riguardano il Libro III) -->
      <div type="book" n="1">
        <head/>
      </div>
      <div type="book" n="2">
        <head/>
      </div>

      <!-- Libro III: focus dell'edizione -->
      <div type="book" n="3">
        <!-- pb facs-free: @facs è ammesso dallo schema ma non usato in questa edizione -->
        <pb n="000r" xml:id="f000r"/>
        <fw/>
        <head/>

        <!-- Proemio (protesta / prologo): head + paragrafi, senza argument -->
        <div type="preface">
          <head/>
          <p n="1" xml:id="III-proem-p1"/>
        </div>

        <!-- Capitoli I–V: stessa struttura; se ne modella uno solo -->
        <div type="chapter" n="0">
          <head/>
          <argument>
            <p/>
          </argument>
          <pb n="000v" xml:id="f000v"/>
          <fw/>

          <!-- Unità di riferimento = il paragrafo <p n="…" xml:id="…">; dentro, i tre layer -->
          <p n="1" xml:id="III-cap0-p1">

            <!-- layer 1: filologico-grafico -->
            <!-- trascrizione a due livelli (diplomatico <-> interpretativo) -->
            <choice><orig/><reg/></choice>
            <choice><abbr/><expan/></choice>
            <choice><sic/><corr/></choice>

            <!-- fenomeni materiali e lacune (fuori dall'apparato) -->
            <unclear/>
            <gap/>
            <supplied/>

            <!-- retrace: ripasso a inchiostro (mano T3, #ink_3-dark); testo INVARIATO,
                 ≠ add (aggiunta) e ≠ subst (correzione), NON va in <app> -->
            <retrace hand="#ink_3-dark" resp="#s-teresa"/>

            <!-- apparato genetico currente calamo (parallel segmentation):
                 del/add/subst stanno DENTRO l'apparato; @varSeq solo con ≥2 rdg concorrenti -->
            <app>
              <lem wit="#txt-c"/>
              <rdg wit="#txt-b0">
                <subst>
                  <del hand="#ink_1" resp="#s-teresa"/>
                  <add hand="#ink_1" resp="#s-teresa"/>
                </subst>
              </rdg>
            </app>

            <!-- layer 2: mistico-dottrinale -->
            <!-- @ref -> categoria del vocabolario controllato #stati-mistici del teiHeader -->
            <term ref="#silentio"/>

            <!-- layer 3: intertestuale -->
            <ref target="#avila-castello"/>
            <cit>
              <quote xml:lang="la">
                <foreign xml:lang="la"/>
              </quote>
              <bibl corresp="#bible-vulgate"/>
            </cit>

          </p>
        </div>
      </div>
    </body>
  </text>
</TEI>
